# Copy this file to ".env" and fill in YOUR OWN keys. Never commit ".env".

# Required: Claude (Anthropic) API key from https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: choose a different Claude model
# CLIPAI_MODEL=claude-sonnet-5-5

# Optional: only needed to transcribe audio/video files (Claude can't do speech-to-text)
# OPENAI_API_KEY=your-openai-api-key-here