{
  "manifest_version": 3,
  "name": "ClipAI",
  "version": "0.2.0",
  "description": "AI-powered screen recorder with automatic bug reports.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "ClipAI",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabCapture", "offscreen", "activeTab"]
}